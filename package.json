{
  "name": "db-game-config-monitor-service",
  "description": "Monitor configs and take automative actions",
  "license": "ISC",
  "type": "module",
  "author": "Billy Bùi",
  "contributors": [
    "Billy Bùi (https://git3.nexdev.net/billy.bui)"
  ],
  "keywords": [
    "prettier",
    "config"
  ],
  "repository": {
    "type": "git",
    "url": "https://git3.nexdev.net/l1/database/services/db-game-configs-monitor-service.git"
  },
  "scripts": {
    "test": "jest --testPathPattern=tests/unit-tests/",
    "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
    "build": "rimraf lib && tsc",
    "dev": "node lib/index.js"
  },
  "files": [
    "lib/**"
  ],
  "dependencies": {
    "@ldb/healthcheck": "0.1.3",
    "@ldb/logger": "1.1.2",
    "@ldb/mongo": "6.10.3",
    "@ldb/utils": "0.3.3",
    "@ldb/watcher": "0.1.0",
    "awilix": "12.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@ldb/eslint-config": "0.2.3",
    "@ldb/prettier-config": "0.1.2",
    "@ldb/tsconfig": "22.0.0",
    "@ldb/vitest-config": "0.1.2",
    "@types/node": "22.9.0",
    "@vitest/coverage-v8": "2.1.5",
    "eslint": "9.14.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
