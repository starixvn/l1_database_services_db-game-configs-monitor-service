    "@commitlint/config-conventional": "19.6.0",
    "@ldb/eslint-config": "0.2.5",
    "@ldb/prettier-config": "0.1.4",
    "@ldb/tsconfig": "22.0.1",
    "@ldb/vitest-config": "0.1.5",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
