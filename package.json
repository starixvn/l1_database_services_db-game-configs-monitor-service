    "@commitlint/config-conventional": "19.8.0",
    "@ldb/eslint-config": "0.2.7",
    "@ldb/prettier-config": "0.1.6",
    "@ldb/tsconfig": "22.0.1",
    "@ldb/vitest-config": "0.1.6",
    "@types/node": "22.13.10",
